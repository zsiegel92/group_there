{
	"exclude": [
		".next/**",
		".venv/**",
		"node_modules/**",
		"out/**",
		"build/**",
		"dist/**",
		".jevlint/**",
		"src/python-client/**",
		"next-env.d.ts",
		"**/*.d.ts"
	],
	"rules_dir": ".jevlint-rules",
	"system_prompt": ".jevlint-system.md",
	"cache_dir": ".jevlint",
	"model": "jev-latest",
	"concurrency": 50,
	"request_timeout_seconds": 30,
	"typesafe_api_key_file": "~/.config/jevlint/typesafe-api-key",
	"rule_sets": [
		{
			"match": ["*.py", "*.pyi", "**/*.py", "**/*.pyi"],
			"error": {
				"python-no-blocking-io-in-async": 0.8,
				"python-validate-boundary-data": 0.8
			},
			"warn": {
				"python-no-silent-exception-fallback": 0.8
			}
		},
		{
			"match": ["*.ts", "*.tsx", "**/*.ts", "**/*.tsx"],
			"error": {
				"typescript-no-client-server-boundary-leaks": 0.8,
				"typescript-validate-boundary-data": 0.8
			},
			"warn": {
				"typescript-no-floating-side-effects": 0.8
			}
		}
	],
	"line_detection": {
		"enabled": true,
		"max_questions_per_request": 100
	},
	"watch": {
		"debounce_milliseconds": 400
	},
	"precondition": {
		"command": [
			"sh",
			"-c",
			"pnpm run tsgo-check && pnpm run lint && pnpm run pr python-type-check && pnpm run pr python-lint"
		]
	}
}
